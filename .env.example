# Copy to .env and fill in. Never commit .env.
# SEC fair-access policy requires a descriptive User-Agent with contact details.
# Required for data.sec.gov sources.
SEC_USER_AGENT="Your Name your.email@example.com"
# Optional: macro data (Phase 4+)
FRED_API_KEY=
# Optional: override framework directory
RESEARCH_ENGINE_FRAMEWORKS=industry_frameworks
